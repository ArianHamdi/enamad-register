# Filled in by ./prod.sh the first time you run it - or edit them here.

# The enamad code (number) you were given, e.g. 60511192
ENAMAD_CODE=

# Your public domain, e.g. mysite.ir
# Its A/AAAA record must already point at this server.
DOMAIN=

# Also serve www.$DOMAIN on the same certificate (1 = yes, 0 = no).
WITH_WWW=1

# Email for the Let's Encrypt account (expiry notices). Optional.
ACME_EMAIL=

# Host ports. Leave as 80/443 - Let's Encrypt needs to reach port 80.
HTTP_PORT=80
HTTPS_PORT=443

# Pinned Caddy image.
CADDY_IMAGE=caddy:2-alpine
